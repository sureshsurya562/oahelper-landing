# Read-only public endpoint that returns the LiveData JSON shape described in lib/live-data.ts.
# Expose ONLY: company, college, created_at, question titles, counts, upcoming OA dates.
# Never user names, emails or phones.
OA_PUBLIC_API_URL=https://api.oahelper.in/public/landing

# Set to 1 to preview the page with clearly-sample data (never enable in production).
USE_SAMPLE_DATA=0
